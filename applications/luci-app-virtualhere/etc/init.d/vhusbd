#!/bin/sh /etc/rc.common
#
# VirtualHere USB Server init script (OpenWrt 21.02)
#
# UCI master switch:
#   vhusbd.@vhusbd[0].enabled = 1  -> allowed to run, started at boot
#   vhusbd.@vhusbd[0].enabled = 0  -> disabled, never started at boot
#
# The option is missing in old configs: keep the historical behaviour
# (enabled), so upgrading does not silently stop a working server.

START=95
STOP=10
USE_PROCD=1

PORT=7575
CONFIG=vhusbd
SECTION='@vhusbd[0]'

is_disabled() {
	local v
	v="$(uci -q get "${CONFIG}.${SECTION}.enabled")"
	case "$v" in
		0|no|false|off|disabled|NO|FALSE|OFF|DISABLED) return 0 ;;
	esac
	return 1
}

fw_off() {
	local i
	i=0
	while [ "$i" -lt 10 ] && iptables -C INPUT -p tcp --dport "$PORT" -j ACCEPT >/dev/null 2>&1; do
		iptables -D INPUT -p tcp --dport "$PORT" -j ACCEPT >/dev/null 2>&1 || break
		i=$((i + 1))
	done
	i=0
	while [ "$i" -lt 10 ] && ip6tables -C INPUT -p tcp --dport "$PORT" -j ACCEPT >/dev/null 2>&1; do
		ip6tables -D INPUT -p tcp --dport "$PORT" -j ACCEPT >/dev/null 2>&1 || break
		i=$((i + 1))
	done
	return 0
}

fw_apply() {
	local wan ipv6
	wan="$(uci -q get "${CONFIG}.${SECTION}.ExtAccess")"
	ipv6="$(uci -q get "${CONFIG}.${SECTION}.IPv6Access")"

	fw_off

	[ "$wan" = "1" ] && iptables -I INPUT -p tcp --dport "$PORT" -j ACCEPT >/dev/null 2>&1
	[ "$ipv6" = "1" ] && ip6tables -I INPUT -p tcp --dport "$PORT" -j ACCEPT >/dev/null 2>&1
	return 0
}

start_service() {
	if is_disabled; then
		# Master switch is off: do not register a procd instance, and make
		# sure nothing started by an old startup entry keeps running.
		# Delete any stale procd instance first, otherwise its respawn logic
		# could revive the process right after killall.
		ubus call service delete '{"name":"vhusbd"}' >/dev/null 2>&1
		killall vhusbd >/dev/null 2>&1
		fw_off
		logger -t vhusbd "service disabled in /etc/config/vhusbd, start skipped"
		return 0
	fi

	fw_apply

	procd_open_instance
	procd_set_param command /usr/bin/vhusbd
	procd_set_param respawn
	procd_close_instance

	logger -t vhusbd "service started"
}

stop_service() {
	killall vhusbd >/dev/null 2>&1
	fw_off
	logger -t vhusbd "service stopped"
}
