#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

# ===== 配置变量（请根据实际情况修改） =====
BINARY="/usr/bin/vhusbd"          # 二进制文件路径，请确认
CONFIG_FILE="/etc/config/vhusbdconfig"     # 配置文件路径
PORT=7575                         # VirtualHere 服务端口
# =========================================

start_service() {
    # 1. 读取 UCI 启用状态（匿名段）
    local enabled
    enabled=$(uci -q get vhusbd.@vhusbd[0].enabled)
    [ "$enabled" = "1" ] || return 1

    # 2. 检查二进制是否存在且可执行
    [ -x "$BINARY" ] || return 1

    # 3. 启动服务（注意：绝对不要加 -b 或 &）
    procd_open_instance
    procd_set_param command "$BINARY"
    procd_append_param command -c "$CONFIG_FILE"
    # 如果程序支持日志参数，可以去掉 -r，改用 procd 的 stdout 日志
    # 若必须保留 -r，请追加：procd_append_param command -r /tmp/vhusbd.log
    procd_append_param command -i   # 监听IPV6端口
    procd_set_param respawn 3600 5 0   # 进程守护：每3600秒检查，失败5次后等待0秒
    procd_set_param stdout 1           # 输出到系统日志（可用 logread 查看）
    procd_set_param stderr 1
    procd_close_instance

    # 4. 防火墙放行端口（如果 ExtAccess 开启）
    local extaccess
    extaccess=$(uci -q get vhusbd.@vhusbd[0].ExtAccess)
    if [ "$extaccess" = "1" ]; then
        # 检查是否已存在规则，避免重复添加
        if ! iptables -C INPUT -p tcp --dport "$PORT" -j ACCEPT -m comment --comment 'virtualhere port' 2>/dev/null; then
            iptables -I INPUT -p tcp --dport "$PORT" -j ACCEPT -m comment --comment 'virtualhere port'
        fi
        if command -v ip6tables >/dev/null 2>&1; then
            if ! ip6tables -C INPUT -p tcp --dport "$PORT" -j ACCEPT -m comment --comment 'virtualhere port' 2>/dev/null; then
                ip6tables -I INPUT -p tcp --dport "$PORT" -j ACCEPT -m comment --comment 'virtualhere port'
            fi
        fi
    fi
}

stop_service() {
    # 移除防火墙规则（忽略不存在的错误）
    iptables -D INPUT -p tcp --dport "$PORT" -j ACCEPT -m comment --comment 'virtualhere port' 2>/dev/null
    if command -v ip6tables >/dev/null 2>&1; then
        ip6tables -D INPUT -p tcp --dport "$PORT" -j ACCEPT -m comment --comment 'virtualhere port' 2>/dev/null
    fi
}

# 关联 UCI 配置变更，当用户点击“保存&应用”时自动重启服务
service_triggers() {
    procd_add_reload_trigger "vhusbd"
}
