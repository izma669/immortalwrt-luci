#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/gmediarender

start_service() {
    # 1. 加载 UCI 配置
    config_load gmediarender
    config_get_bool enabled main enabled 0
    
    # 2. 关键优化：如果界面没勾选“启用”，就不启动，防止后台偷偷运行
    [ "$enabled" -eq 1 ] || return 0

    config_get friendly_name main friendly_name "OpenWrt-Speaker"
    
    # 3. 关键优化：优先使用 br-lan，如果获取不到再回退到 LAN IP，避免绑定到 0.0.0.0 导致组播发错网卡
    config_get interface main interface "br-lan"
    
    procd_open_instance
    # 去掉 -d 参数（procd 本身就以后台守护进程方式管理，加 -d 可能导致 procd 认为进程退出了而反复重启）
    procd_set_param command "$PROG" -f "$friendly_name" -I "$interface"
    
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/gmediarender
    procd_close_instance
}

stop_service() {
    :
}

reload_service() {
    stop
    start
}
