#!/bin/sh

# ============================================
# 1. 初始化 UCI 默认配置（仅当配置不存在时）
# ============================================
if ! uci -q get gmediarender.main >/dev/null 2>&1; then
    uci set gmediarender.main=service
    uci set gmediarender.main.enabled='0'
    uci set gmediarender.main.friendly_name='OpenWrt-Speaker'
    uci set gmediarender.main.interface='br-lan'
    uci set gmediarender.main.port='49152'
    uci set gmediarender.main.enable_log='1'
    uci set gmediarender.main.logfile='/var/log/gmediarender.log'
    uci set gmediarender.main.log_cleanup='1'
    uci set gmediarender.main.log_limit_mb='5'
    uci commit gmediarender
fi

# ============================================
# 2. 确保清理脚本可执行（兜底）
# ============================================
[ -f /usr/bin/gmr-logcleanup.sh ] && chmod 755 /usr/bin/gmr-logcleanup.sh

# ============================================
# 3. 添加 cron 任务（幂等，不覆盖已有任务）
# ============================================
CRON_MARK="luci-gmediarender-logcleanup"
CRON_LINE="*/30 * * * * /usr/bin/gmr-logcleanup.sh # $CRON_MARK"

if [ -x /etc/init.d/cron ]; then
    if ! crontab -l 2>/dev/null | grep -qF "$CRON_MARK"; then
        ( crontab -l 2>/dev/null; echo "$CRON_LINE" ) | sort -u | crontab -
    fi
    /etc/init.d/cron enable 2>/dev/null
    /etc/init.d/cron restart 2>/dev/null
fi

exit 0
