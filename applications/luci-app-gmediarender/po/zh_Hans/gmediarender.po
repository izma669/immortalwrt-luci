msgid "GMediaRender"
msgstr "GMediaRender 音频DLNA接收器"

msgid "GMediaRender is a UPnP/DLNA audio renderer. It allows you to push audio from your phone or computer to this device."
msgstr "GMediaRender 是一个 UPnP/DLNA 音频渲染器。你可以将手机或电脑上的音频推送到此设备播放。"

msgid "Basic Settings"
msgstr "基本设置"

msgid "Enable"
msgstr "启用"

msgid "Enable GMediaRender service"
msgstr "启用 GMediaRender 服务"

msgid "Friendly Name"
msgstr "设备名称"

msgid "The name that appears on DLNA controllers"
msgstr "在 DLNA 客户端中显示的名称"

msgid "Listen Interface"
msgstr "监听接口"

msgid "IP address or interface name to bind (e.g. br-lan or 192.168.1.1)"
msgstr "绑定的 IP 地址或网卡名（如 br-lan 或 192.168.1.1）"

msgid "Port"
msgstr "端口"

msgid "UPnP event port (default 49152)"
msgstr "UPnP 事件端口（默认 49152）"

msgid "Log File"
msgstr "日志文件"

msgid "Path to log file (leave empty to disable logging)"
msgstr "日志文件路径（留空则关闭日志）"

msgid "Status"
msgstr "状态"

msgid "Service Status"
msgstr "服务状态"

msgid "Enabled"
msgstr "已启用"
