# 播放器主页面和 TS 依赖，永远从 /www 读（跟媒体根目录无关）
location = /player.html {
    root /www;
}
location = /mpegts.min.js {
    root /www;
}

# 根路径直接给播放器
location = / {
    rewrite ^ /player.html last;
}

# JSON 目录 API，跟下面 location / 的 root 保持一致
location /api/dir/ {
    alias /mnt/sda1/media/;
    autoindex on;
    autoindex_format json;
    autoindex_exact_size on;
}

# 媒体文件（必须显式指定 root，否则继承 http 块的 /www）
location ~* \.(mp4|webm|mkv|mov|avi|m4v|ogv|flv|3gp|ts|m2ts|wmv|mp3|m4a|flac|aac|ogg|wav)$ {
    root /mnt/sda1/media;
    add_header Accept-Ranges bytes;
    add_header Cache-Control "public, max-age=3600";
}

# 兜底：真实文件优先，否则播放器
location / {
    root /mnt/sda1/media;
    try_files $uri /player.html;
}
