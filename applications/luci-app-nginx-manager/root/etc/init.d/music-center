#!/bin/sh /etc/rc.common
# =============================================================================
# 音乐中心（Music Center）服务
#
#   /etc/init.d/music-center start    启动 888 站点 + AirPlay 元数据读取器
#   /etc/init.d/music-center stop     停用 888 站点 + 读取器
#   /etc/init.d/music-center restart
#
#   /etc/init.d/music-center start_all    启动三个音乐插件
#   /etc/init.d/music-center stop_all     停止三个音乐插件
#   /etc/init.d/music-center restart_all  重启三个音乐插件
#
# 说明：
#   * 三个插件仍然保留各自的 init（procd 负责崩溃拉起、开机顺序）；
#     music-center 只合并了原来 shairport-sync 外挂的元数据读取脚本，
#     并给网页提供统一的启动/停止/重启入口。
#   * 888 的 server 配置是 /etc/nginx/conf.d/music.conf；stop 时改名为
#     music.conf.disabled 并 reload nginx，start 时恢复。
#   * 有些路由器（例如 ImmortalWrt 上的自定义 nginx）没有
#     /etc/init.d/nginx 或 /etc/nginx/nginx.conf：
#       - 有 init 时走 nginx -t + init reload；
#       - 没有 init 时直接给运行中的 nginx master 发 HUP；
#       - 如果系统 nginx 仍然没有监听 888，则用
#         /tmp/music-center-nginx.conf 启动一个独立的 nginx 实例。
# =============================================================================

START=99
STOP=10
USE_PROCD=1

CONF=/etc/nginx/conf.d/music.conf
CONF_OFF=/etc/nginx/conf.d/music.conf.disabled
READER=/usr/bin/music-center-reader.lua
NGINX_BIN=$(command -v nginx 2>/dev/null)
MUSIC_PORT=$(sed -n 's/^[[:space:]]*listen[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$CONF" 2>/dev/null | head -n 1)
[ -n "$MUSIC_PORT" ] || MUSIC_PORT=888

restore_music_conf() {
    [ -f "$CONF_OFF" ] || return 0
    if [ -f "$CONF" ]; then
        # 升级后新配置已就位，直接丢弃旧的停用备份
        rm -f "$CONF_OFF"
    else
        mv -f "$CONF_OFF" "$CONF"
    fi
}

hide_music_conf() {
    [ -f "$CONF" ] || return 0
    mv -f "$CONF" "$CONF_OFF"
}

# 找到运行中 nginx 的 master PID：
#   1) 标准 pid 文件
#   2) ps 里的 "nginx: master process"
#   3) pidof 的最后一个 PID（兜底）
nginx_master_pid() {
    local p
    p=$(cat /var/run/nginx.pid 2>/dev/null)
    [ -n "$p" ] && [ -d "/proc/$p" ] && { echo "$p"; return 0; }
    p=$(cat /run/nginx.pid 2>/dev/null)
    [ -n "$p" ] && [ -d "/proc/$p" ] && { echo "$p"; return 0; }
    p=$(ps w 2>/dev/null | awk '/[n]ginx: master process/ {print $1; exit}')
    [ -n "$p" ] && { echo "$p"; return 0; }
    p=$(pidof nginx 2>/dev/null | awk '{print $NF}')
    [ -n "$p" ] && { echo "$p"; return 0; }
    return 1
}

reload_nginx() {
    # 标准 nginx 包：有 init 就用 init
    if [ -x /etc/init.d/nginx ]; then
        nginx -t >/dev/null 2>&1 || {
            logger -t music-center "nginx 配置检查失败，未 reload"
            return 1
        }
        /etc/init.d/nginx reload >/dev/null 2>&1
        return $?
    fi

    # 没有 /etc/init.d/nginx 的自定义 nginx：直接 HUP master。
    # 它使用启动时的 -c 配置，不依赖 /etc/nginx/nginx.conf。
    # 你的系统配置是 /etc/nginx/uci.conf，先按它做一次检查（失败也继续尝试 HUP）。
    if [ -f /etc/nginx/uci.conf ]; then
        nginx -t -c /etc/nginx/uci.conf >/dev/null 2>&1 \
            || logger -t music-center "uci.conf 配置检查失败，仍尝试 HUP"
    fi
    local master
    master=$(nginx_master_pid)
    if [ -n "$master" ]; then
        kill -HUP "$master" 2>/dev/null && return 0
    fi
    logger -t music-center "找不到 nginx master 进程，无法 reload $MUSIC_PORT 配置"
    return 1
}

music_888_listening() {
    command -v netstat >/dev/null 2>&1 || return 1
    netstat -ltn 2>/dev/null | grep -qE "[:.]${MUSIC_PORT}[[:space:]]"
}

music_888_ok() {
    if command -v wget >/dev/null 2>&1; then
        wget -q -O - -T 2 "http://127.0.0.1:$MUSIC_PORT/" 2>/dev/null | grep -q '音乐中心'
    elif command -v netstat >/dev/null 2>&1; then
        music_888_listening
    else
        return 0
    fi
}

# 系统 nginx 无法提供 888 时使用的独立配置。
# 不依赖 /etc/nginx/nginx.conf / mime.types，只 include 我们的 server 块。
write_standalone_conf() {
    cat > /tmp/music-center-nginx.conf <<'EOF'
worker_processes 1;
error_log /tmp/music-center-nginx-error.log warn;
pid /var/run/music-center-nginx.pid;

events {
    worker_connections 1024;
}

http {
    types {
        text/html html htm;
        text/css css;
        application/javascript js;
        application/json json;
        image/svg+xml svg;
        image/png png;
        image/jpeg jpg jpeg;
        image/webp webp;
        image/x-icon ico;
    }
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    include /etc/nginx/conf.d/music.conf;
}
EOF
}

start_service() {
    config_load music-center
    local reader
    config_get_bool reader main reader 1

    if [ ! -s /www/music-center/index.html ]; then
        logger -t music-center "警告：/www/music-center/index.html 缺失或为空，$MUSIC_PORT 页面会空白"
    fi

    restore_music_conf

    if [ -f "$CONF" ]; then
        local mp
        mp=$(sed -n 's/^[[:space:]]*listen[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$CONF" 2>/dev/null | head -n 1)
        [ -n "$mp" ] && MUSIC_PORT="$mp"
    fi

    if [ -f "$CONF" ]; then
        if ! reload_nginx; then
            logger -t music-center "系统 nginx 未 reload，将尝试独立实例"
        fi
        sleep 2
        if music_888_ok; then
            :
        elif music_888_listening; then
            logger -t music-center "$MUSIC_PORT 端口已被占用但页面内容异常，请检查 /www/music-center 或 nginx 配置"
        elif [ -n "$NGINX_BIN" ]; then
            write_standalone_conf
            procd_open_instance "nginx888"
            procd_set_param command "$NGINX_BIN" -c /tmp/music-center-nginx.conf -g "daemon off;"
            procd_set_param respawn 3600 5 5
            procd_set_param stdout 0
            procd_set_param stderr 0
            procd_close_instance
            logger -t music-center "已启动独立 nginx 实例提供 $MUSIC_PORT"
        else
            logger -t music-center "缺少 nginx，无法启动 $MUSIC_PORT"
        fi
    else
        logger -t music-center "缺少 $CONF，$MUSIC_PORT 站点未启用"
    fi

    if [ "$reader" -eq 1 ] && [ -f "$READER" ] && [ -x /usr/bin/lua ] \
        && [ -x /usr/bin/shairport-sync ]; then
        # 旧 shairport-reader 如果还在跑，先停掉，避免两个进程同时写 JSON
        for p in $(ps w 2>/dev/null | awk '/[s]hairport-reader\.lua/ {print $1}'); do
            kill "$p" 2>/dev/null
        done
        procd_open_instance "reader"
        procd_set_param command /usr/bin/lua "$READER"
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 0
        procd_set_param stderr 0
        procd_close_instance
        logger -t music-center "启动元数据读取器"
    elif [ "$reader" -eq 1 ]; then
        logger -t music-center "元数据读取器未启动：检查 $READER、/usr/bin/lua、/usr/bin/shairport-sync"
    fi
}

stop_service() {
    hide_music_conf
    # 系统 nginx 若加载过 888，用 HUP 让它释放端口；独立实例由 procd 停止
    reload_nginx >/dev/null 2>&1
    return 0
}

reload_service() {
    stop
    start
}

start_all() {
    for s in gmediarender owntone shairport-sync; do
        [ -x "/etc/init.d/$s" ] && /etc/init.d/$s start
    done
}

stop_all() {
    for s in shairport-sync owntone gmediarender; do
        [ -x "/etc/init.d/$s" ] && /etc/init.d/$s stop
    done
}

restart_all() {
    for s in gmediarender owntone shairport-sync; do
        [ -x "/etc/init.d/$s" ] && /etc/init.d/$s restart
    done
}
