#!/bin/sh /etc/rc.common
# =============================================================================
# 音乐中心 / 媒体服务器 —— 唯一服务
#
# 启动一个 music-center-daemon：
#   - 插件自己的 nginx（880 + 888，配置 /etc/music-center/nginx.conf）
#   - AirPlay 元数据读取
#   - DLNA 发现
#   - 封面后台下载
#
# 系统 nginx（80/443）不在这里管理，不会被 reload / restart。
# =============================================================================

START=96
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/music-center-daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
