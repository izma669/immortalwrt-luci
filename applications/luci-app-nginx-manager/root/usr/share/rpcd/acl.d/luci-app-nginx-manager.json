{
  "luci-app-nginx-manager": {
    "description": "Grant access to Nginx configuration",
    "read": {
      "file": {
        "/etc/nginx/conf.d/nginx.conf": [ "read" ]
      }
    },
    "write": {
      "file": {
        "/etc/nginx/conf.d/nginx.conf": [ "write" ]
      },
      "exec": {
        "/etc/init.d/*": [ "reload", "restart", "start", "stop" ],
        "/usr/sbin/nginx": [ "-t" ]
      }
    }
  }
}
