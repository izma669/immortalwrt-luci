{
  "luci-app-nginx-manager": {
    "description": "Grant access to Nginx configuration",
    "read": {
      "uci": [ "nginx" ],
      "ubus": { "service": [ "list" ] },
      "file": { "/etc/config/nginx": [ "read" ] }
    },
    "write": {
      "uci": [ "nginx" ],
      "file": { "/etc/config/nginx": [ "write" ] }
    }
  }
}
