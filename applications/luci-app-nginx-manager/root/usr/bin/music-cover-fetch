#!/usr/bin/lua
-- 自动为音乐库歌曲下载同名封面：Song.flac -> Song.jpg
-- 已存在同名 jpg/jpeg/png/webp 时直接跳过。
-- 用法：
--   music-cover-fetch --one /path/to/song.flac
--   music-cover-fetch --loop 1800
--   music-cover-fetch --scan

local fs = require "nixio.fs"
local uci = require "luci.model.uci".cursor()
local jsonc = require "luci.jsonc"
local nixio = require "nixio"

local LOG = "/tmp/music-cover.log"
local AUDIO_EXT = { "flac", "mp3", "m4a", "aac", "ogg", "opus", "wav", "aif", "aiff", "ape", "wv", "dsf", "dff" }
local COVER_EXT = { "jpg", "jpeg", "png", "webp" }

local function log(msg)
    local f = io.open(LOG, "a")
    if f then
        f:write(os.date("%Y-%m-%d %H:%M:%S "), tostring(msg), "\n")
        f:close()
    end
end

local function q(s)
    return string.format("%q", tostring(s))
end

local function urlencode(s)
    return (tostring(s):gsub("([^%w%-%._~])", function(ch)
        return string.format("%%%02X", string.byte(ch))
    end))
end

local function base_of(path)
    return (path:gsub("%.[%w]+$", ""))
end

local function find_cover(path)
    local base = base_of(path)
    for _, ext in ipairs(COVER_EXT) do
        local p = base .. "." .. ext
        if fs.access(p) then return p end
    end
    return nil
end

local function http_get(url, timeout)
    local tmp = "/tmp/music-cover-http." .. tostring(os.time()) .. "." .. tostring(math.random(100000, 999999))
    local cmd
    if fs.access("/usr/bin/curl") then
        cmd = string.format("curl -fsSL --max-time %d -o %s %s", timeout or 20, q(tmp), q(url))
    else
        cmd = string.format("wget -q -O %s %s", q(tmp), q(url))
    end
    os.execute(cmd)
    local data = fs.readfile(tmp)
    os.remove(tmp)
    return data
end

local function bin_ok(name)
    return fs.access("/usr/bin/" .. name) or fs.access("/usr/sbin/" .. name) or fs.access("/bin/" .. name)
end

local EMBED_MARK = "/tmp/music-cover-embedded"

local function embed_mark(song)
    fs.mkdirr(EMBED_MARK)
    return EMBED_MARK .. "/" .. nixio.md5(tostring(song))
end

local function already_embedded(song)
    local ext = tostring(song:match("%.(%w+)$") or ""):lower()
    if ext == "flac" and bin_ok("metaflac") then
        local p = io.popen(string.format("metaflac --list --block-type=PICTURE %s 2>/dev/null", q(song)))
        if p then
            local out = p:read("*a") or ""
            p:close()
            if out:find("PICTURE", 1, true) then return true end
        end
    end
    if bin_ok("ffprobe") then
        local p = io.popen(string.format("ffprobe -v error -select_streams v -show_entries stream=codec_name -of csv=p=0 %s 2>/dev/null", q(song)))
        if p then
            local out = p:read("*a") or ""
            p:close()
            if out:gsub("%s", "") ~= "" then return true end
        end
    end
    local mark = embed_mark(song)
    local sm = fs.stat(mark)
    local sf = fs.stat(song)
    if sm and sf and tonumber(sm.mtime or 0) >= tonumber(sf.mtime or 0) then return true end
    return false
end

-- 把同名封面写进歌曲标签，让 OwnTone 自己的库也能显示
local function embed_cover(song, cover)
    if tostring(uci:get_first("owntone", "owntone", "cover_embed") or "1") == "0" then return false end
    local ext = tostring(song:match("%.(%w+)$") or ""):lower()

    local function ffmpeg_embed(audio_only)
        -- 临时文件不放到音乐目录，避免 OwnTone 把 .cover.tmp 当成歌曲
        local tmp = song .. ".cover.tmp"
        local out_fmt = ext
        if ext == "m4a" then out_fmt = "ipod" elseif ext == "aac" then out_fmt = "adts" end
        local maps = audio_only and "-map 0:a -map 1:v" or "-map 0 -map 1"
        local extra = audio_only and "" or "-id3v2_version 3 "
        local cmd = string.format(
            "ffmpeg -y -loglevel error -i %s -i %s %s %s-map_metadata 0 -map_chapters 0 -c copy "
            .. "-disposition:v attached_pic -metadata:s:v title='Album cover' "
            .. "-metadata:s:v comment='Cover (front)' -f %s %s",
            q(song), q(cover), maps, extra, out_fmt, q(tmp))
        os.execute(cmd)
        local st = fs.stat(tmp)
        if st and st.size and st.size > 1024 then
            os.rename(tmp, song)
            fs.writefile(embed_mark(song), tostring(os.time()))
            return true
        end
        os.remove(tmp)
        return false
    end

    if ext == "flac" then
        if bin_ok("metaflac") then
            os.execute(string.format("metaflac --remove --block-type=PICTURE --dont-use-padding %s >/dev/null 2>&1", q(song)))
            local rc = os.execute(string.format("metaflac --import-picture-from=%s %s >/dev/null 2>&1", q(cover), q(song)))
            if rc == 0 or rc == true then
                fs.writefile(embed_mark(song), tostring(os.time()))
                return true
            end
        end
        if bin_ok("ffmpeg") then return ffmpeg_embed(true) end
        return false
    end

    if (ext == "mp3" or ext == "m4a" or ext == "aac") and bin_ok("ffmpeg") then
        return ffmpeg_embed(false)
    end
    return false
end
local function rescan_owntone()
    local port = tonumber(uci:get_first("owntone", "owntone", "mpd_port")) or 6600
    local s = nixio.socket("inet", "stream")
    if not s then return end
    pcall(function() s:setopt("socket", "rcvtimeo", 3) end)
    pcall(function() s:setopt("socket", "sndtimeo", 3) end)
    if not s:connect("127.0.0.1", port) then s:close(); return end
    s:recv(256)
    s:send("update\nclose\n")
    s:close()
end

local function download(url, dest)
    local tmp = dest .. ".part." .. tostring(os.time()) .. "." .. tostring(math.random(100000, 999999))
    local cmd
    if fs.access("/usr/bin/curl") then
        cmd = string.format("curl -fsSL --max-time 30 -o %s %s", q(tmp), q(url))
    else
        cmd = string.format("wget -q -O %s %s", q(tmp), q(url))
    end
    os.execute(cmd)
    local st = fs.stat(tmp)
    if st and st.size and st.size > 1024 then
        os.rename(tmp, dest)
        return true
    end
    os.remove(tmp)
    return false
end

local function search_itunes(term)
    for _, country in ipairs({ "CN", "US" }) do
        local api = "https://itunes.apple.com/search?term=" .. urlencode(term)
            .. "&entity=song&limit=1&country=" .. country
        local body = http_get(api, 20)
        if body and body ~= "" then
            local ok, data = pcall(jsonc.parse, body)
            if ok and type(data) == "table" and type(data.results) == "table" and data.results[1] then
                local art = tostring(data.results[1].artworkUrl100 or data.results[1].artworkUrl60 or "")
                if art ~= "" then
                    art = art:gsub("100x100bb", "600x600bb")
                        :gsub("100x100", "600x600")
                        :gsub("60x60bb", "600x600bb")
                    return art
                end
            end
        end
    end
    return nil
end

local STAGE_FILE = "/tmp/music-cover-stage"
local function stage(s, path)
    local f = io.open(STAGE_FILE, "w")
    if f then f:write(tostring(s) .. "|" .. tostring(path or "") .. "|" .. tostring(os.time())); f:close() end
end

local function fetch_one(path, artist, title)
    path = tostring(path or ""):gsub("^file:/+", "/")
    if path == "" or not fs.access(path) then return false end
    -- 失败的曲目 24 小时内不再重复请求，避免每轮扫描刷同一条日志
    local fail_mark = path .. ".cover.none"
    local fm = fs.stat(fail_mark)
    if fm and (os.time() - (tonumber(fm.mtime) or 0)) < 86400 then return false end
    stage("reading", path)
    local existing = find_cover(path)
    if existing then
        if embed_cover(path, existing) then
            stage("file", path)
            log("embedded(existing): " .. path)
            return true, true
        end
        return true, false
    end

    local name = path:match("([^/]+)%.[%w]+$") or ""
    artist = tostring(artist or "")
    title = tostring(title or "")
    if artist == "Unknown artist" or artist == "未知艺术家" or artist == "未知" then artist = "" end
    if title == "Unknown" or title == "未知" then title = "" end
    if artist == "" or title == "" then
        local clean = name:gsub("_", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
        local a, t = clean:match("^(.-)%s+%-%s+(.+)$")
        if a and t then
            artist = a
            title = t
        else
            title = clean
            artist = ""
        end
    end
    if title == "" then return false end

    local term = title .. (artist ~= "" and (" " .. artist) or "")
    stage("searching", path)
    local art = search_itunes(term)
    if not art then
        stage("none", path)
        fs.writefile(fail_mark, tostring(os.time()))
        log("no result: " .. path)
        return false
    end
    local dest = base_of(path) .. ".jpg"
    stage("downloading", path)
    if download(art, dest) then
        fs.unlink(fail_mark)
        log("saved: " .. dest)
        stage("embedding", path)
        if embed_cover(path, dest) then
            stage("online", path)
            log("embedded: " .. path)
            return true, true
        end
        return true, false
    end
    fs.writefile(fail_mark, tostring(os.time()))
    log("download failed: " .. path)
    return false, false
end

local AUDIO_SET = {}
for _, ext in ipairs(AUDIO_EXT) do AUDIO_SET[ext] = true end

local function list_audio(dir)
    local list = {}
    -- BusyBox 的 find 对 \( -o \) 支持不稳定，这里列出全部文件再用 Lua 过滤
    local p = io.popen(string.format("find %s -type f 2>/dev/null", q(dir)))
    if p then
        for line in p:lines() do
            local ext = line:match("%.([%w]+)$")
            if ext and AUDIO_SET[ext:lower()] then
                list[#list + 1] = line
            end
        end
        p:close()
    end
    return list
end

local function music_dirs()
    local out, seen = {}, {}
    local function add(d)
        d = tostring(d or ""):gsub("/+$", "")
        if d ~= "" and not seen[d] then
            seen[d] = true
            out[#out + 1] = d
        end
    end
    local ud = tostring(uci:get_first("owntone", "owntone", "directories") or "")
    for d in ud:gmatch("[^:%s]+") do add(d) end
    local conf = fs.readfile("/etc/owntone.conf") or ""
    local block = conf:match("directories%s*=%s*{([^}]*)}")
    if block then
        for d in block:gmatch('"([^"]+)"') do add(d) end
    end
    if #out == 0 then
        for _, d in ipairs({ "/mnt", "/media", "/srv" }) do
            if fs.access(d) then add(d) end
        end
    end
    return out
end

local function scan()
    local count, saved, embedded = 0, 0, 0
    local dirs = music_dirs()
    if os.getenv("MUSIC_COVER_VERBOSE") then log("dirs: " .. table.concat(dirs, " ")) end
    for _, dir in ipairs(dirs) do
        if fs.access(dir) then
            for _, path in ipairs(list_audio(dir)) do
                count = count + 1
                local ok, emb = fetch_one(path)
                if ok then saved = saved + 1 end
                if emb then embedded = embedded + 1 end
                -- 避免 iTunes 接口限流
                os.execute("sleep 2")
            end
        end
    end
    if embedded > 0 then rescan_owntone() end
    log(string.format("scan done: files=%d covered=%d embedded=%d", count, saved, embedded))
end

local mode = arg[1] or "--scan"
if mode == "--one" then
    local ok, emb = fetch_one(arg[2], arg[3], arg[4])
    if emb then rescan_owntone() end
elseif mode == "--loop" then
    local interval = tonumber(arg[2]) or 1800
    while true do
        scan()
        os.execute("sleep " .. tostring(interval))
    end
else
    scan()
end
