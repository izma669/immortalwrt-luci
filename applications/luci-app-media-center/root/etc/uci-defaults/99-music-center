#!/bin/sh
# 首次安装后让音乐中心随系统启动
# 手工复制/Windows 打包常丢 +x，这里顺手补上
chmod +x /usr/bin/music-center-daemon 2>/dev/null
chmod +x /usr/bin/music-center-reader.lua 2>/dev/null
chmod +x /usr/bin/music-center-restart 2>/dev/null
chmod +x /usr/bin/music-cover-fetch 2>/dev/null
chmod +x /usr/bin/media-center.lua 2>/dev/null
chmod +x /etc/init.d/music-center 2>/dev/null
# 传输过程常丢执行位，这里统一补上（含依赖的 gmediarender / owntone）
for f in /etc/init.d/music-center /etc/init.d/gmediarender /etc/init.d/owntone \
         /usr/bin/music-center-daemon /usr/bin/gmediarender /usr/bin/owntone; do
    [ -f "$f" ] && chmod +x "$f" 2>/dev/null
done

chmod +x /etc/uci-defaults/99-music-center 2>/dev/null
[ -x /etc/init.d/music-center ] && /etc/init.d/music-center enable

# 把网页监听码率写入 OwnTone 配置
RATE=$(uci -q get owntone.owntone.stream_bitrate)
if [ -n "$RATE" ] && [ -f /etc/owntone.conf ]; then
    sed -i "s/^[[:space:]]*bitrate[[:space:]]*=.*/\tbitrate = $RATE/" /etc/owntone.conf
fi

# ---- 媒体中心：默认值 + 首次安装写入 uhttpd 的 files 段 ----
if [ -z "$(uci -q get media-center.media)" ]; then
    uci -q set media-center.media=media
    uci -q set media-center.media.port='880'
    uci -q set media-center.media.root='/mnt'
    uci -q set media-center.media.enabled='1'
    uci -q commit media-center
fi
if [ -z "$(uci -q get media-center.music)" ]; then
    uci -q set media-center.music=music
    uci -q set media-center.music.port='888'
    uci -q commit media-center
fi

# 888 站点需要 /cgi-bin/luci，软链到系统 cgi-bin（/www 是 tmpfs，每次开机重建）
mkdir -p /www/music-center
ln -sfn /www/cgi-bin /www/music-center/cgi-bin

PORT=$(uci -q get media-center.media.port); PORT=${PORT:-880}
ROOT=$(uci -q get media-center.media.root); ROOT=${ROOT:-/mnt}
ENABLED=$(uci -q get media-center.media.enabled); ENABLED=${ENABLED:-1}
if [ "$ENABLED" != "0" ] && [ -z "$(uci -q get uhttpd.files)" ]; then
    uci -q set uhttpd.files=uhttpd
    uci -q set uhttpd.files.home="$ROOT"
    uci -q set uhttpd.files.rfc1918_filter='1'
    uci -q set uhttpd.files.tcp_keepalive='1'
    uci -q add_list "uhttpd.files.listen_http=0.0.0.0:$PORT"
    uci -q add_list "uhttpd.files.listen_http=[::]:$PORT"
    uci -q commit uhttpd
    /etc/init.d/uhttpd restart >/dev/null 2>&1
fi

# 让 OwnTone 使用 softvol 软件声卡，音量独立于主声卡
if [ -f /etc/init.d/owntone ] && ! grep -q 'card = "softvol"' /etc/init.d/owntone 2>/dev/null; then
    sed -i 's|^\ttype = "alsa"$|\ttype = "alsa"\n\tcard = "softvol"\n\tmixer = "Softvol"\n\tmixer_device = "hw:0"|' /etc/init.d/owntone
    /etc/init.d/owntone restart >/dev/null 2>&1
fi
exit 0
